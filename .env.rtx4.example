# DeepSeek V4 Flash DSpark profile for one 4x RTX PRO 6000 Blackwell host.
# Copy to .env.rtx4 and adjust paths/ports.

HF_CACHE=/opt/dlami/nvme/hf
HF_HUB_DISABLE_XET=1
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# Flash-0731 is the official post-trained release. DSpark is included in this
# same checkpoint; do not set DSPARK_DRAFT_MODEL for this model.
DSPARK_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
SERVED_MODEL_NAME=deepseek-v4-flash-dspark
VLLM_HOST=0.0.0.0
PORT=8000

DSPARK_VLLM_IMAGE=vllm-dspark-runtime:rtx4-nvfp4-port-v3
CONTAINER_NAME=deepseek-v4-flash-dspark-rtx4
GPUS=0,1,2,3
TP_SIZE=4
DCP_SIZE=1
# DeepSeek-V4's upstream DCP implementation uses a2a. Leave empty for the
# runtime default when DCP is disabled.
DCP_COMM_BACKEND=

# lucifer-cutlass is the strongest documented RTX PRO 6000 path in the
# local-inference-lab v8 matrix. b12x and lucifer-default are useful fallback
# probes.
BACKEND=lucifer-cutlass
# Optional explicit linear kernel override. Leave blank for vLLM auto-selection.
LINEAR_BACKEND=
# Disable only when the installed DeepGEMM build lacks this GPU architecture.
USE_DEEP_GEMM=1

# DeepSeek V4's supported sparse-MLA KV format. The runtime image retains the
# DSpark and NVFP4-weight patches; this setting applies only to the KV cache.
KV_CACHE_DTYPE=fp8_ds_mla

# Leave empty to use the checkpoint's native context limit (1,048,576 tokens).
MAX_MODEL_LEN=
MAX_NUM_SEQS=64
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.92
CUDA_GRAPH_CAPTURE_SIZE=512
# PIECEWISE is the stable DCP/SM12.x mode; FULL_AND_PIECEWISE is faster when
# safe but has a known DeepSeek-V4 chunked-prefill hang on SM12.x.
CUDAGRAPH_MODE=FULL_AND_PIECEWISE
# Diagnostic escape hatch for graph-related SM12.x/DCP startup failures.
ENFORCE_EAGER=0
# Set to 0 to disable speculative decoding (required for DCP_SIZE > 1).
DSPARK_NUM_TOKENS=5
DSPARK_SAMPLE=greedy
PREFIX_CACHE=1
FLASHINFER_AUTOTUNE=1
SCHEDULING_POLICY=priority
# Disable while validating TP4+DCP4. The async scheduler uses a split
# execute/sample worker queue that can deadlock with this experimental path.
ASYNC_SCHEDULING=0
PULL_IMAGE=0

# Verified on a 4x RTX PRO 6000 worker. vLLM uses host memory first, then
# spills colder KV blocks to the local-NVMe path when the host tier is full.
KV_OFFLOAD_GB=256
KV_OFFLOAD_DISK_DIR=/opt/dlami/nvme/kv-offload

GENERATION_TEMPERATURE=0.0
GENERATION_TOP_P=1.0
GENERATION_TOP_K=40
GENERATION_REPETITION_PENALTY=1.05
GENERATION_MAX_TOKENS=384000
