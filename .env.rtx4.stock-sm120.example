# Hermia-compatible stock-vLLM profile for one 4x RTX PRO 6000 SM120 host.
# Copy to .env.rtx4.stock-sm120. This profile is intentionally separate from
# .env.rtx4 and the custom B12X/DCP/DSpark production runtime.
#
# Build and launch:
#   docker build -f recipe/rtx4/Dockerfile.stock-sm120 \
#     -t vllm-dspark-runtime:stock-sm120-vllm-0.25.1 .
#   cp .env.rtx4.stock-sm120.example .env.rtx4.stock-sm120
#   ./start-deepseek-v4-flash-stock-sm120-rtx4.sh

HF_CACHE=/opt/dlami/nvme/deepseek-model/hf
# Existing host model directory after HF_CACHE is mounted at /cache/huggingface.
MODEL_DIR=/cache/huggingface/model
# Persist kernel/autotune caches across disposable container restarts.
VLLM_CACHE_DIR=/opt/dlami/nvme/deepseek-model/hf/vllm-cache-stock-sm120-v0.25.1-fi0.6.14

# vLLM keeps a 256 GiB host-memory KV tier and writes content-addressed spill
# blocks to the local instance-store NVMe filesystem. The launcher refuses to
# start if the directory resolves anywhere other than this dedicated mount, so
# a missing mount cannot fill Docker's root-disk writable layer.
KV_OFFLOAD_GB=256
KV_OFFLOAD_DISK_DIR=/opt/dlami/nvme/kv-offload
KV_OFFLOAD_REQUIRED_MOUNT=/opt/dlami/nvme/kv-offload
KV_OFFLOAD_IMAGE=/opt/dlami/nvme/.kv-offload.ext4
KV_OFFLOAD_MAX_DISK_GB=4096
KV_OFFLOAD_MIN_FREE_GB=1024
KV_OFFLOAD_READ_THREADS=32
KV_OFFLOAD_WRITE_THREADS=16
HF_HUB_DISABLE_XET=1

DSPARK_MODEL=deepseek-ai/DeepSeek-V4-Flash-DSpark
SERVED_MODEL_NAME=deepseek-v4-flash-dspark
DSPARK_VLLM_IMAGE=vllm-dspark-runtime:stock-sm120-vllm-0.25.1
CONTAINER_NAME=deepseek-v4-flash-stock-sm120-rtx4
VLLM_HOST=0.0.0.0
PORT=8000
GPUS=0,1,2,3

# The stock SM120 recipe has been validated only as TP4 + expert parallel.
TP_SIZE=4
DCP_SIZE=1
DSPARK_NUM_TOKENS=0
KV_CACHE_DTYPE=fp8

# Do not raise this on the stock path. Longer single-request prefills can hit a
# DeepGEMM launch failure that takes a GPU offline even though the KV pool is
# large enough to hold more tokens.
MAX_MODEL_LEN=262144
GPU_MEMORY_UTILIZATION=0.90
PULL_IMAGE=0
